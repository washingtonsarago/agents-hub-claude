#!/usr/bin/env node
// ahc — agents-hub-claude CLI
// Zero-dep Node. Commands: sync | list | pin | unpin | config

const fs = require('fs');
const path = require('path');
const os = require('os');
const https = require('https');
const http = require('http');
const crypto = require('crypto');
const { URL } = require('url');
const { execSync } = require('child_process');

const HOME = os.homedir();
const CLAUDE_DIR = path.join(HOME, '.claude');
const AGENTS_DIR = path.join(CLAUDE_DIR, 'agents');
const COMMANDS_DIR = path.join(CLAUDE_DIR, 'commands');
const SKILLS_DIR = path.join(CLAUDE_DIR, 'skills');
const CACHE_DIR = path.join(CLAUDE_DIR, '.ahc-cache');
const LOCK_FILE = path.join(CLAUDE_DIR, '.ahc-lock.json');
const CONFIG_FILE = path.join(CLAUDE_DIR, '.ahc-config.json');

// Single-file categories (one .md per item, target = <dir>/<name>.md).
const CATEGORIES = [
  { key: 'agents',   manifestKey: 'agents',   dir: AGENTS_DIR,   label: 'agent',   ext: '.md' },
  { key: 'commands', manifestKey: 'commands', dir: COMMANDS_DIR, label: 'command', ext: '.md' },
];

const DEFAULT_CONFIG = {
  repo: 'EMS-NCTECH/agents-hub-claude',
  branch: 'main',
  channel: 'stable',
};

const ARGS = process.argv.slice(2);
const FLAGS = {
  quiet: ARGS.includes('--quiet'),
  timeout: parseInt((ARGS.find(a => a.startsWith('--timeout')) || '').split('=')[1] || '10', 10) * 1000 || 10000,
  force: ARGS.includes('--force'),
};

function log(...a) { if (!FLAGS.quiet) console.log(...a); }
function err(...a) { console.error(...a); }

function readJSON(p, fallback) {
  try { return JSON.parse(fs.readFileSync(p, 'utf8')); } catch { return fallback; }
}
function writeJSON(p, obj) {
  fs.mkdirSync(path.dirname(p), { recursive: true });
  fs.writeFileSync(p, JSON.stringify(obj, null, 2) + '\n');
}

function loadConfig() { return { ...DEFAULT_CONFIG, ...readJSON(CONFIG_FILE, {}) }; }
function loadLock() {
  const lock = readJSON(LOCK_FILE, { agents: {}, commands: {}, skills: {}, pins: {} });
  if (!lock.agents) lock.agents = {};
  if (!lock.commands) lock.commands = {};
  if (!lock.skills) lock.skills = {};
  if (!lock.pins) lock.pins = {};
  return lock;
}
function saveLock(lock) { writeJSON(LOCK_FILE, lock); }

function fetchURL(url) {
  return new Promise((resolve, reject) => {
    const u = new URL(url);
    const lib = u.protocol === 'file:' ? null : (u.protocol === 'http:' ? http : https);
    if (!lib) {
      try { resolve(fs.readFileSync(u.pathname, 'utf8')); } catch (e) { reject(e); }
      return;
    }
    const req = lib.get(url, { timeout: FLAGS.timeout, headers: { 'User-Agent': 'ahc' } }, res => {
      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
        fetchURL(res.headers.location).then(resolve, reject);
        return;
      }
      if (res.statusCode !== 200) { reject(new Error(`HTTP ${res.statusCode} ${url}`)); return; }
      let data = '';
      res.on('data', c => data += c);
      res.on('end', () => resolve(data));
    });
    req.on('error', reject);
    req.on('timeout', () => { req.destroy(new Error('timeout')); });
  });
}

function rawURL(cfg, filePath) {
  if (cfg.repo.startsWith('file://') || cfg.repo.startsWith('http')) {
    return `${cfg.repo.replace(/\/$/, '')}/${filePath}`;
  }
  return `https://raw.githubusercontent.com/${cfg.repo}/${cfg.branch}/${filePath}`;
}

function isGitRepo(cfg) {
  return !cfg.repo.startsWith('file://') && !cfg.repo.startsWith('http');
}

function gitRefresh(cfg) {
  const cache = path.join(CACHE_DIR, cfg.repo.replace(/[^a-zA-Z0-9._-]/g, '_'));
  fs.mkdirSync(CACHE_DIR, { recursive: true });
  const url = `https://github.com/${cfg.repo}.git`;
  const quiet = FLAGS.quiet ? '--quiet' : '';
  try {
    if (fs.existsSync(path.join(cache, '.git'))) {
      execSync(`git -C "${cache}" fetch origin "${cfg.branch}" --depth=1 ${quiet}`, { stdio: FLAGS.quiet ? 'pipe' : 'inherit' });
      execSync(`git -C "${cache}" reset --hard FETCH_HEAD ${quiet}`, { stdio: FLAGS.quiet ? 'pipe' : 'inherit' });
    } else {
      execSync(`git clone --depth=1 --branch "${cfg.branch}" ${quiet} "${url}" "${cache}"`, { stdio: FLAGS.quiet ? 'pipe' : 'inherit' });
    }
  } catch (e) {
    throw new Error(`git fetch failed for ${cfg.repo}@${cfg.branch}: ${e.message}`);
  }
  return cache;
}

async function readFromSource(cfg, filePath, cachePath) {
  if (cachePath) {
    return fs.readFileSync(path.join(cachePath, filePath), 'utf8');
  }
  return await fetchURL(rawURL(cfg, filePath));
}

function sha256(s) { return crypto.createHash('sha256').update(s).digest('hex'); }

async function syncCategory(cat, manifest, lock, cfg, cachePath) {
  const items = manifest[cat.manifestKey] || [];
  if (items.length === 0) return { added: 0, updated: 0, skipped: 0, pinned: 0 };

  fs.mkdirSync(cat.dir, { recursive: true });
  let updated = 0, added = 0, skipped = 0, pinned = 0;

  for (const item of items) {
    if (item.scope && item.scope !== 'user') continue;
    const target = path.join(cat.dir, `${item.name}${cat.ext}`);
    const current = lock[cat.key][item.name];
    const pin = lock.pins[item.name];

    if (pin && pin !== item.version && !FLAGS.force) {
      pinned++;
      log(`[pinned]  ${cat.label} ${item.name} @ ${pin} (remote ${item.version})`);
      continue;
    }
    if (current && current.sha256 === item.sha256 && fs.existsSync(target)) { skipped++; continue; }

    const body = await readFromSource(cfg, item.path, cachePath);
    const got = sha256(body);
    if (got !== item.sha256) {
      err(`[ahc] hash mismatch for ${cat.label} ${item.name}: expected ${item.sha256}, got ${got}`);
      continue;
    }
    fs.writeFileSync(target, body);
    lock[cat.key][item.name] = { version: item.version, sha256: item.sha256, path: target };
    if (current) { updated++; log(`[updated] ${cat.label} ${item.name} ${current.version} → ${item.version}`); }
    else { added++; log(`[added]   ${cat.label} ${item.name} ${item.version}`); }
  }

  return { added, updated, skipped, pinned };
}

// Skills are multi-file: each manifest entry has `files: [{path, sha256}]`.
// Target for a skill file is ~/.claude/skills/<name>/<rel-path-after-skills/<name>/>.
async function syncSkills(manifest, lock, cfg, cachePath) {
  const items = manifest.skills || [];
  if (items.length === 0) return { added: 0, updated: 0, skipped: 0, pinned: 0 };

  fs.mkdirSync(SKILLS_DIR, { recursive: true });
  let added = 0, updated = 0, skipped = 0, pinned = 0;

  for (const item of items) {
    if (item.scope && item.scope !== 'user') continue;
    const current = lock.skills[item.name];
    const pin = lock.pins[item.name];

    if (pin && pin !== item.version && !FLAGS.force) {
      pinned++;
      log(`[pinned]  skill ${item.name} @ ${pin} (remote ${item.version})`);
      continue;
    }

    const skillRoot = path.join(SKILLS_DIR, item.name);
    // Map manifest paths → relative paths under the skill directory.
    const fileMap = (item.files || []).map(f => ({
      manifestPath: f.path,
      relPath: f.path.replace(new RegExp(`^skills/${item.name}/`), ''),
      sha256: f.sha256,
    }));

    const allCached = current && current.files && fileMap.every(f => {
      const local = current.files[f.relPath];
      return local === f.sha256 && fs.existsSync(path.join(skillRoot, f.relPath));
    });
    if (allCached) { skipped++; continue; }

    const localFiles = {};
    let failed = false;
    for (const f of fileMap) {
      const target = path.join(skillRoot, f.relPath);
      let body;
      try { body = await readFromSource(cfg, f.manifestPath, cachePath); }
      catch (e) {
        err(`[ahc] failed to read skill file ${f.manifestPath}: ${e.message}`);
        failed = true; break;
      }
      const got = sha256(body);
      if (got !== f.sha256) {
        err(`[ahc] hash mismatch for skill ${item.name} :: ${f.relPath} — expected ${f.sha256}, got ${got}`);
        failed = true; break;
      }
      fs.mkdirSync(path.dirname(target), { recursive: true });
      fs.writeFileSync(target, body);
      localFiles[f.relPath] = f.sha256;
    }
    if (failed) continue;

    lock.skills[item.name] = { version: item.version, files: localFiles };
    if (current) { updated++; log(`[updated] skill ${item.name} ${current.version} → ${item.version}`); }
    else { added++; log(`[added]   skill ${item.name} ${item.version} (${fileMap.length} files)`); }
  }

  return { added, updated, skipped, pinned };
}

async function cmdSync() {
  const cfg = loadConfig();
  const lock = loadLock();

  let cachePath = null;
  let manifest;
  try {
    if (isGitRepo(cfg)) {
      cachePath = gitRefresh(cfg);
      manifest = JSON.parse(fs.readFileSync(path.join(cachePath, 'manifest.json'), 'utf8'));
    } else {
      const raw = await fetchURL(rawURL(cfg, 'manifest.json'));
      manifest = JSON.parse(raw);
    }
  } catch (e) {
    err(`[ahc] offline or unreachable (${e.message}) — keeping local cache`);
    process.exit(FLAGS.quiet ? 0 : 1);
  }

  const totals = { added: 0, updated: 0, skipped: 0, pinned: 0 };
  for (const cat of CATEGORIES) {
    const r = await syncCategory(cat, manifest, lock, cfg, cachePath);
    totals.added += r.added;
    totals.updated += r.updated;
    totals.skipped += r.skipped;
    totals.pinned += r.pinned;
  }
  const sr = await syncSkills(manifest, lock, cfg, cachePath);
  totals.added += sr.added;
  totals.updated += sr.updated;
  totals.skipped += sr.skipped;
  totals.pinned += sr.pinned;

  lock.last_sync = new Date().toISOString();
  lock.manifest_version = manifest.version;
  saveLock(lock);
  log(`[ahc] sync ok — added:${totals.added} updated:${totals.updated} skipped:${totals.skipped} pinned:${totals.pinned}`);
}

async function cmdList() {
  const cfg = loadConfig();
  const lock = loadLock();
  let manifest = null;
  try {
    if (isGitRepo(cfg)) {
      const cachePath = gitRefresh(cfg);
      manifest = JSON.parse(fs.readFileSync(path.join(cachePath, 'manifest.json'), 'utf8'));
    } else {
      manifest = JSON.parse(await fetchURL(rawURL(cfg, 'manifest.json')));
    }
  } catch {}

  console.log(`repo: ${cfg.repo}@${cfg.branch} (${cfg.channel})`);

  // Optional `--team <bucket>` filter (only meaningful for agents).
  const teamFilter = (() => {
    const a = ARGS.find(x => x.startsWith('--team='));
    if (a) return a.slice('--team='.length).split(',').map(s => s.trim()).filter(Boolean);
    const i = ARGS.indexOf('--team');
    if (i !== -1 && ARGS[i + 1]) return ARGS[i + 1].split(',').map(s => s.trim()).filter(Boolean);
    return null;
  })();

  function renderRow(name, local, remote, pin) {
    let status = '  ';
    if (!local && remote) status = '++';
    else if (local && remote && local.sha256 !== remote.sha256) status = '↑↑';
    else if (local && !remote) status = '--';
    const v = local ? local.version : '-';
    const r = remote ? remote.version : '-';
    const pinTag = pin ? ` [pin:${pin}]` : '';
    return `${status} ${name.padEnd(30)} local:${v.padEnd(8)} remote:${r}${pinTag}`;
  }

  for (const cat of CATEGORIES) {
    const remoteItems = manifest ? (manifest[cat.manifestKey] || []) : [];
    const localItems = lock[cat.key] || {};
    const names = new Set([...Object.keys(localItems), ...remoteItems.map(i => i.name)]);
    if (names.size === 0) continue;

    // Group agents by team. Other categories print flat (no team concept yet).
    if (cat.key === 'agents') {
      const buckets = new Map(); // team -> [name]
      for (const name of [...names].sort()) {
        const remote = remoteItems.find(i => i.name === name);
        const team = (remote && remote.team) || '(no-team)';
        if (teamFilter && !teamFilter.includes(team)) continue;
        if (!buckets.has(team)) buckets.set(team, []);
        buckets.get(team).push(name);
      }
      const total = [...buckets.values()].reduce((n, arr) => n + arr.length, 0);
      console.log(`\nAGENTS (${total}${teamFilter ? `, filtered by team=${teamFilter.join(',')}` : ''})`);
      for (const team of [...buckets.keys()].sort()) {
        const list = buckets.get(team);
        console.log(`\n  ${team} (${list.length})`);
        for (const name of list) {
          const local = localItems[name];
          const remote = remoteItems.find(i => i.name === name);
          console.log(`  ${renderRow(name, local, remote, lock.pins[name])}`);
        }
      }
      continue;
    }

    console.log(`\n${cat.key.toUpperCase()}`);
    for (const name of [...names].sort()) {
      const local = localItems[name];
      const remote = remoteItems.find(i => i.name === name);
      console.log(renderRow(name, local, remote, lock.pins[name]));
    }
  }

  // Skills (multi-file): compare by version + per-file shas.
  const remoteSkills = manifest ? (manifest.skills || []) : [];
  const localSkills = lock.skills || {};
  const skillNames = new Set([...Object.keys(localSkills), ...remoteSkills.map(i => i.name)]);
  if (skillNames.size > 0) {
    console.log(`\nSKILLS`);
    for (const name of [...skillNames].sort()) {
      const local = localSkills[name];
      const remote = remoteSkills.find(i => i.name === name);
      const pin = lock.pins[name];
      let status = '  ';
      if (!local && remote) status = '++';
      else if (local && !remote) status = '--';
      else if (local && remote) {
        const drift = (remote.files || []).some(f => {
          const rel = f.path.replace(new RegExp(`^skills/${name}/`), '');
          return !local.files || local.files[rel] !== f.sha256;
        });
        if (drift) status = '↑↑';
      }
      const v = local ? local.version : '-';
      const r = remote ? remote.version : '-';
      const pinTag = pin ? ` [pin:${pin}]` : '';
      const fileCount = remote ? (remote.files || []).length : (local && local.files ? Object.keys(local.files).length : 0);
      console.log(`${status} ${name.padEnd(30)} local:${v.padEnd(8)} remote:${r}${pinTag}  (${fileCount} files)`);
    }
  }

  console.log('\nlegend: ++ new  ↑↑ update available  -- removed remotely');
}

function cmdPin() {
  const spec = ARGS[1];
  if (!spec || !spec.includes('@')) { err('usage: ahc pin <name>@<version>'); process.exit(2); }
  const [name, version] = spec.split('@');
  const lock = loadLock();
  lock.pins[name] = version;
  saveLock(lock);
  console.log(`[pinned] ${name} @ ${version}`);
}

function cmdUnpin() {
  const name = ARGS[1];
  if (!name) { err('usage: ahc unpin <name>'); process.exit(2); }
  const lock = loadLock();
  delete lock.pins[name];
  saveLock(lock);
  console.log(`[unpinned] ${name}`);
}

function cmdConfig() {
  const kv = ARGS[1];
  if (!kv) { console.log(JSON.stringify(loadConfig(), null, 2)); return; }
  if (!kv.includes('=')) { err('usage: ahc config <key>=<value>'); process.exit(2); }
  const [k, v] = kv.split('=');
  const cfg = loadConfig();
  cfg[k] = v;
  writeJSON(CONFIG_FILE, cfg);
  console.log(`[config] ${k} = ${v}`);
}

function help() {
  console.log(`ahc — agents-hub-claude

commands:
  sync [--quiet] [--timeout=N] [--force]   fetch manifest and update agents + commands
  list [--team=<a,b,...>]                  show local vs remote state; agents grouped by team
  pin <name>@<version>                     pin an item version (agent or command)
  unpin <name>                             remove pin
  config [key=value]                       show or set config (repo, branch, channel)
  help                                     this message

files:
  ~/.claude/agents/                        where agents are installed
  ~/.claude/commands/                      where commands are installed
  ~/.claude/skills/                        where skills are installed (multi-file per skill)
  ~/.claude/.ahc-lock.json                 local lock
  ~/.claude/.ahc-config.json               local config
`);
}

(async () => {
  const cmd = ARGS[0] || 'help';
  try {
    if (cmd === 'sync') await cmdSync();
    else if (cmd === 'list') await cmdList();
    else if (cmd === 'pin') cmdPin();
    else if (cmd === 'unpin') cmdUnpin();
    else if (cmd === 'config') cmdConfig();
    else help();
  } catch (e) {
    err(`[ahc] ${e.message}`);
    process.exit(1);
  }
})();
